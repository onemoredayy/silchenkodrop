generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: "USER" | "ADMIN"   (SQLite не умеет enum — поэтому строки)
model User {
  id           String          @id @default(cuid())
  steamId      String          @unique
  username     String
  avatar       String?
  balance      Float           @default(0)
  role         String          @default("USER")
  isBanned     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  lastLoginAt  DateTime        @default(now())
  openings     Opening[]
  inventory    InventoryItem[]
  transactions Transaction[]
  upgrades     Upgrade[]
  contracts    Contract[]
  battles      BattlePlayer[]
  battleDrops  BattleDrop[]
  battlesWon   Battle[]        @relation("BattleWinner")
  battlesMade  Battle[]        @relation("BattleCreator")
  promoUses    PromoUse[]
  // бонус к следующему пополнению от промокода, %
  depositBonus Float           @default(0)
  depositPromo String?
}

// Блоки кейсов на главной: «СИЛЬЧЕНКО», «Обычные кейсы» и т.д.
model CaseSection {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  sortOrder Int    @default(0)
  cases     Case[]
}

model Case {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  price       Float // цену кейса ставит админ вручную
  image       String?
  description String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  sectionId   String?
  section     CaseSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  officialId  String? // id кейса из игры (для «Обычных кейсов»)
  items       CaseItem[]
  openings    Opening[]
}

// rarity: COMMON | UNCOMMON | RARE | MYTHICAL | LEGENDARY | ANCIENT
model Item {
  id             String          @id @default(cuid())
  name           String
  rarity         String
  price          Float // запасная цена, если нет цены из каталога
  image          String?
  wear           String?
  statTrak       Boolean         @default(false)
  marketHashName String?
  catalog        SkinCatalog?    @relation(fields: [marketHashName], references: [marketHashName])
  cases          CaseItem[]
  openings       Opening[]
  inventory      InventoryItem[]
  upgradeTargets Upgrade[]
  contracts      Contract[]
  battleDrops    BattleDrop[]
}

model CaseItem {
  id         String @id @default(cuid())
  caseId     String
  itemId     String
  dropChance Float
  case       Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  item       Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([caseId, itemId])
}

model Opening {
  id        String   @id @default(cuid())
  userId    String
  caseId    String
  itemId    String
  pricePaid Float
  itemPrice Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model InventoryItem {
  id         String    @id @default(cuid())
  userId     String
  itemId     String
  dropPrice  Float
  acquiredAt DateTime  @default(now())
  isSold     Boolean   @default(false) // true — больше не в инвентаре (продан или сгорел в апгрейде)
  upgraded   Boolean   @default(false) // ушёл в апгрейд
  soldPrice  Float?
  soldAt     DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, isSold])
}

model Upgrade {
  id         String   @id @default(cuid())
  userId     String
  fromValue  Float
  targetId   String
  targetPrice Float
  chance     Float // %
  roll       Float // 0..1, выигрыш если roll < chance/100
  success    Boolean
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  target     Item     @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

// Контракт: 3–10 своих скинов → один случайный скин из каталога
model Contract {
  id          String   @id @default(cuid())
  userId      String
  inputCount  Int
  inputValue  Float
  resultId    String
  resultPrice Float
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  result      Item     @relation(fields: [resultId], references: [id], onDelete: Cascade)
}

// Батл: 2–4 игрока открывают одни и те же кейсы, у кого дроп дороже — забирает всё
// status: OPEN (ждём игроков) | DONE | CANCELLED
model Battle {
  id         String         @id @default(cuid())
  creatorId  String
  maxPlayers Int
  caseIds    String // JSON-массив id кейсов по порядку раундов (повторы можно)
  cost       Float // сколько платит каждый участник
  status     String         @default("OPEN")
  winnerId   String?
  createdAt  DateTime       @default(now())
  finishedAt DateTime?
  creator    User           @relation("BattleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  winner     User?          @relation("BattleWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  players    BattlePlayer[]
  drops      BattleDrop[]

  @@index([status, createdAt])
}

model BattlePlayer {
  id       String   @id @default(cuid())
  battleId String
  userId   String
  slot     Int
  total    Float    @default(0)
  joinedAt DateTime @default(now())
  battle   Battle   @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, slot])
  @@unique([battleId, userId])
}

model BattleDrop {
  id       String @id @default(cuid())
  battleId String
  userId   String
  round    Int
  itemId   String
  price    Float
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// Промокод. kind: BALANCE — сразу +value ₽ на баланс; DEPOSIT — +value% к следующему пополнению
model Promo {
  id        String     @id @default(cuid())
  code      String     @unique // хранится в верхнем регистре
  kind      String
  value     Float
  maxUses   Int        @default(0) // 0 — без ограничения
  uses      Int        @default(0)
  isActive  Boolean    @default(true)
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  usages    PromoUse[]
}

model PromoUse {
  id        String   @id @default(cuid())
  promoId   String
  userId    String
  createdAt DateTime @default(now())
  promo     Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoId, userId])
}

// type: DEPOSIT | OPEN | SELL | ADMIN | BATTLE | BATTLE_REFUND
model Transaction {
  id        String   @id @default(cuid())
  userId    String
  type      String
  amount    Float
  meta      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Картинки, загруженные в админке (кейсы). id — хеш содержимого.
model Upload {
  id        String   @id
  type      String
  data      Bytes
  createdAt DateTime @default(now())
}

model SiteSetting {
  key   String @id
  value String
}

// Каталог: каждая строка — конкретный предмет рынка Steam (качество, StatTrak).
// Список — ByMykel/CSGO-API, цены — prices.csgotrader.app (Steam, в USD → ₽ по курсу ЦБ).
model SkinCatalog {
  id              String    @id @default(cuid())
  marketHashName  String    @unique
  baseName        String    @default("") // «AK-47 | Redline» без качества и StatTrak
  name            String // отображаемое имя (= baseName)
  weapon          String
  category        String?
  rarity          String
  rarityColor     String?
  wear            String?
  statTrak        Boolean   @default(false)
  isDefault       Boolean   @default(false) // «основной» вариант скина: без ST, самое ходовое качество
  image           String?
  price           Float?
  lastPriceUpdate DateTime?
  createdAt       DateTime  @default(now())
  items           Item[]

  @@index([baseName])
  @@index([weapon])
  @@index([price])
}
