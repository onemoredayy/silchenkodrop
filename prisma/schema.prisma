generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: "USER" | "ADMIN"   (SQLite не умеет enum — поэтому строки)
model User {
  id           String          @id @default(cuid())
  steamId      String          @unique
  username     String
  avatar       String?
  balance      Float           @default(0)
  role         String          @default("USER")
  isBanned     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  lastLoginAt  DateTime        @default(now())
  openings     Opening[]
  inventory    InventoryItem[]
  transactions Transaction[]
}

model Case {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  price       Float // цену кейса ставит админ вручную
  image       String?
  description String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  items       CaseItem[]
  openings    Opening[]
}

// rarity: COMMON | UNCOMMON | RARE | MYTHICAL | LEGENDARY | ANCIENT
model Item {
  id             String          @id @default(cuid())
  name           String
  rarity         String
  price          Float // запасная цена, если нет цены из каталога
  image          String?
  wear           String?
  statTrak       Boolean         @default(false)
  marketHashName String?
  catalog        SkinCatalog?    @relation(fields: [marketHashName], references: [marketHashName])
  cases          CaseItem[]
  openings       Opening[]
  inventory      InventoryItem[]
}

model CaseItem {
  id         String @id @default(cuid())
  caseId     String
  itemId     String
  dropChance Float
  case       Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  item       Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([caseId, itemId])
}

model Opening {
  id        String   @id @default(cuid())
  userId    String
  caseId    String
  itemId    String
  pricePaid Float
  itemPrice Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model InventoryItem {
  id         String    @id @default(cuid())
  userId     String
  itemId     String
  dropPrice  Float
  acquiredAt DateTime  @default(now())
  isSold     Boolean   @default(false)
  soldPrice  Float?
  soldAt     DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, isSold])
}

// type: DEPOSIT | OPEN | SELL | ADMIN
model Transaction {
  id        String   @id @default(cuid())
  userId    String
  type      String
  amount    Float
  meta      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SiteSetting {
  key   String @id
  value String
}

// Полный каталог скинов CS2 (из ByMykel/CSGO-API), цены — со Steam Market
model SkinCatalog {
  id              String    @id @default(cuid())
  marketHashName  String    @unique
  name            String
  weapon          String
  rarity          String
  rarityColor     String?
  wear            String?
  image           String?
  price           Float?
  lastPriceUpdate DateTime?
  createdAt       DateTime  @default(now())
  items           Item[]

  @@index([name])
  @@index([weapon])
  @@index([lastPriceUpdate])
}
