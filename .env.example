# База данных SQLite (файл prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Длинная случайная строка для подписи входа. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=""

# Необязательно:
# STEAM_API_KEY=""        — без ключа ник и аватар берутся из открытого профиля
# ADMIN_STEAM_IDS=""      — SteamID64 админов через запятую; по умолчанию админ — первый вошедший
# APP_URL=""              — адрес сайта, если автоопределение по запросу не подходит
